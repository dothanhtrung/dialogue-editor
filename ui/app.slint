import {
    TextEdit,
    Button,
    ListView,
    ComboBox,
    LineEdit,
    Palette,
    TabWidget,
} from "std-widgets.slint";
import {
    EditableTextBox,
    SelectableBox,
} from "app_widgets.slint";
import { StatusBar } from "status_bar.slint";
import { FileSection, GFile, UnsaveLoadDialog } from "file_section.slint";
import { NotiBox, GNoti } from "noti.slint";
import { StringId, GNameMap, NameMapTab } from "namemap_tab.slint";
import { ContentTab, GContent } from "content_tab.slint";
import { ConfigTab, GConfig } from "config_tab.slint";
import { Vertical } from "material-1.0/material.slint";

export { GNoti, GNameMap, GContent, GConfig, GFile, UnsaveLoadDialog }
export component AppWindow inherits Window {
    title: "Dialogue Editor";

    in-out property <bool> is_saved: true;

    public function show_notification() {
        noti_box.show();
    }

    noti_box := NotiBox {
        x: parent.width - self.width - 20px;
        y: 20px;
    }

    Vertical {
        TabWidget {
            orientation: Orientation.vertical;

            Tab {
                title: "C";

                ContentTab {
                    is_saved <=> root.is_saved;
                }
            }

            Tab {
                title: "E";

                NameMapTab {
                    is_saved <=> root.is_saved;
                }
            }

            Tab {
                title: "S";

                ConfigTab { }
            }
        }

        FileSection { }

        StatusBar {
            is_saved <=> root.is_saved;
        }
    }
}
