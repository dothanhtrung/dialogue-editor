import {
    TextEdit,
    Button,
    VerticalBox,
    HorizontalBox,
    ListView,
    ComboBox,
} from "std-widgets.slint";
import { TextInputToggle } from "app_widgets.slint";

export struct Dialogue {
    contents: [{content: string, language:string}],
    affects: [{class: string, state: string}],
}

export component AppWindow inherits Window {
    in-out property <string> file_path;
    in-out property <[string]> classes;
    in-out property <[string]> states;
    in-out property <[Dialogue]> dialogues;
    callback request-save();
    callback request-load(string);
    callback select-class(string);
    callback remove-class(string);
    callback add-class(string);
    callback rename-class(string, string); // old name, new name
    callback select-state(string);
    callback remove-state(string);
    callback add-state(string);
    callback rename-state(string, string); // old name, new name
    callback add-dialog(string);
    callback remove-dialog(int);
    VerticalBox {
        HorizontalBox {
            // Class actor
            VerticalBox {
                ListView {
                    for class_name[i] in classes: TextInputToggle {
                        value: class_name;
                        select => {
                            select-class(class_name);
                        };
                        submit(new_name) => {
                            rename-class(class_name, new_name);
                        };
                        delete => {
                            remove-class(class_name);
                        };
                    }
                }

                new_class := TextInput {
                    text: "New class";
                }

                Button {
                    text: "Add";
                    clicked => {
                        root.add-class(new_class.text);
                    };
                }
            }

            // Dialogue State
            VerticalBox {
                ListView {
                    for state_name in states: TextInputToggle {
                        value: state_name;
                        select => {
                            select-state(state_name);
                        };
                        submit(new_name) => {
                            rename-state(state_name, new_name);
                        };
                        delete => {
                            remove-state(state_name);
                        };
                    }
                }

                new_state := TextInput {
                    text: "New state";
                }

                Button {
                    text: "Add";
                    clicked => {
                        root.add-state(new_state.text);
                    }
                }
            }

            // Dialogue content
            VerticalBox {
                ListView {
                    for dialog[i] in dialogues: VerticalBox {
                        ListView {
                            for content[j] in dialog.contents: HorizontalBox {
                                TextEdit {
                                    text: content.content;
                                }

                                ComboBox {
                                    current-value: content.language;
                                }
                            }
                        }

                        ComboBox {
                            model: classes;
                        }

                        ComboBox {
                            // TODO: Filter states by selected class in combo box
                            model: states;
                        }
                    }
                }

                new_dialog := TextEdit { }

                language_edit := ComboBox { }

                Button {
                    text: "Add";
                    clicked => {
                        root.add-dialog(new_dialog.text);
                    }
                }
            }
        }

        file_path_input := TextInput {
            text: root.file_path;
        }

        Button {
            text: "Load";
            clicked => {
                root.request-load(file_path_input.text);
            }
        }

        Button {
            text: "Save";
            clicked => {
                root.request-save();
            }
        }
    }
}
