import {
    TextEdit,
    Button,
    VerticalBox,
    HorizontalBox,
    ListView,
    ComboBox,
} from "std-widgets.slint";
import {
    EditableTextBox,
    UiDialogue,
    DialogueBox,
    SelectableBox,
} from "app_widgets.slint";


export component AppWindow inherits Window {
    in-out property <string> file_path;
    in-out property <[string]> classes;
    in-out property <[string]> states;
    in-out property <[string]> dialogues;
    in-out property <UiDialogue> dialogue;
    in-out property <[string]> lang-list;

    callback request-save();
    callback request-load(string);

    callback select-class(string);
    callback remove-class(string);
    callback add-class(string);
    callback rename-class(string, string); // old name, new name
    
    callback select-state(string);
    callback remove-state(string);
    callback add-state(string);
    callback rename-state(string, string); // old name, new name

    callback select-dialog(int);
    callback add-dialog();
    callback remove-dialog(int);

    callback new_lang_content(string, string); // lang, content
    callback new_affect(string, string); // affect_class, affect_state
    callback update_content(UiDialogue); // dialog

    VerticalBox {
        HorizontalBox {
            // Class actor
            VerticalBox {
                ListView {
                    for class_name[i] in classes: EditableTextBox {
                        value: class_name;
                        select => {
                            select-class(class_name);
                        };
                        submit(new_name) => {
                            rename-class(class_name, new_name);
                        };
                        delete => {
                            remove-class(class_name);
                        };
                    }
                }

                new_class := TextInput {
                    text: "New class";
                }

                Button {
                    text: "Add";
                    clicked => {
                        root.add-class(new_class.text);
                    };
                }
            }

            // Dialogue State
            VerticalBox {
                ListView {
                    for state_name in states: EditableTextBox {
                        value: state_name;
                        select => {
                            select-state(state_name);
                        };
                        submit(new_name) => {
                            rename-state(state_name, new_name);
                        };
                        delete => {
                            remove-state(state_name);
                        };
                    }
                }

                new_state := TextInput {
                    text: "New state";
                }

                Button {
                    text: "Add";
                    clicked => {
                        root.add-state(new_state.text);
                    }
                }
            }

            // Dialogue content
            VerticalBox {
                ListView {
                    for dialog[i] in dialogues: SelectableBox {
                        value: dialog;
                        select => {
                            select-dialog(i);
                        };
                        delete => {
                            remove-dialog(i);
                        };
                    }
                }

                Button {
                    text: "Add";
                    clicked => {
                        root.add-dialog();
                    }
                }
            }

            // Dialog detail
            VerticalBox {
                DialogueBox {
                    dialogue: dialogue;
                    lang_list: lang-list;
                    class_list: classes;
                    state_list: states;

                    update_content => {
                        update_content(self.dialogue);
                    };
                    new_lang_content(lang, content) => {
                        new_lang_content(lang, content);
                    };
                    new_affect(class, state) => {
                        new_affect(class, state);
                    };
                }
            }
        }

        file_path_input := TextInput {
            text: root.file_path;
        }

        Button {
            text: "Load";
            clicked => {
                root.request-load(file_path_input.text);
            }
        }

        Button {
            text: "Save";
            clicked => {
                root.request-save();
            }
        }
    }
}
