import {
    TextEdit,
    Button,
    VerticalBox,
    HorizontalBox,
    ListView,
    ComboBox,
    LineEdit,
    Palette,
    TabWidget,
} from "std-widgets.slint";
import {
    EditableTextBox,
    SelectableBox,
} from "app_widgets.slint";
import { StatusBar } from "status_bar.slint";
import { FileSection } from "file_section.slint";
import { NotiBox, GNoti } from "noti.slint";
import { StringId, GNameMap, NameMapContainer } from "namemap_tab.slint";
import { ContentContainer, GContent } from "content_tab.slint";

export { GNoti, GNameMap, GContent }

// TODO: Config UI

export component AppWindow inherits Window {
    in-out property <string> file_path;
    in-out property <int> file_format;
    in-out property <string> encrypt_key;
    in-out property <bool> enable_crypt: false;
    in-out property <bool> is_saved: true;

    callback request-save(string, int, string, bool);
    callback request-load(string, int, string);

    callback file_picker();

    noti_box := NotiBox {
        x: parent.width - self.width - 20px;
        y: 20px;
    }

    public function show_notification() {
        noti_box.show();
    }

    VerticalLayout {
        TabWidget {
            orientation: Orientation.vertical;

            Tab {
                title: "C";

                ContentContainer {
                    is_saved <=> root.is_saved;
                }
            }

            Tab {
                title: "E";

                NameMapContainer { }
            }

            Tab {
                title: "S";
            }
        }

        FileSection {
            file_format: root.file_format;
            file_path: root.file_path;
            enable_crypt: root.enable_crypt;
            encrypt_key: root.encrypt_key;

            height: 10%;

            browse_click => {
                root.file_picker();
            }

            load(path_str, type_int, encrypt_str) => {
                root.request-load(path_str, type_int, encrypt_str);
            }

            save(path_str, type_int, encrypt_str, save_without_name) => {
                root.request-save(path_str, type_int, encrypt_str, save_without_name);
            }
        }

        StatusBar {
            height: 5%;
            is_saved <=> root.is_saved;
        }
    }
}
