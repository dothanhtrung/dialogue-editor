import {
    TabReload,
    EditableTextBox,
    SelectableBox,
    SearchBox,
} from "app_widgets.slint";
import {
    Palette,
    LineEdit,
    ListView,
    Button,
    ComboBox,
    TextEdit,
} from "std-widgets.slint";
import {
    Vertical,
    Horizontal,
    OutlinedCard,
    ElevatedCard,
    IconButton,
    TextButton,
    FilledCard,
    ElevatedButton,
    HorizontalDivider,
} from "material-1.0/material.slint";
import { Icons } from "material-1.0/ui/icons/icons.slint";


export struct ContentLang {
    language: string,
    content: string,
}

export struct Affect {
    class: string,
    state: string,
}

export struct UiDialogue {
    contents: [ContentLang],
    affects: [Affect],
    events: [string],
}

export global GContent {
    in-out property <[string]> classes;
    in-out property <[string]> states;
    in-out property <[string]> dialogues;
    in-out property <UiDialogue> dialogue;
    in-out property <[string]> lang_list;
    in-out property <[string]> state_list;
    in-out property <[string]> event_list;

    callback select-class(string);
    callback remove-class(string);
    callback add-class(string);
    callback rename-class(string, string); // old name, new name

    callback select-state(string);
    callback remove-state(string);
    callback add-state(string);
    callback rename-state(string, string); // old name, new name

    callback select-dialog(int);
    callback add-dialog();
    callback remove-dialog(int);

    callback add_lang_content(string, string); // lang, content
    callback add_affect(string, string); // affect_class, affect_state
    callback add_event(string);
    callback update_content(UiDialogue); // TODO: This is alrready in GContent, do not need to pass it again
    callback delete_content(string);
    callback delete_affect(string);
    callback delete_event(int);

    callback search_class(string);
    callback search_state(string);
    callback search_dialogue(string);
}

export component DialogueBox inherits Rectangle {
    in property <[string]> class_list; // TODO: Class list from name map too
    property <int> content_selecting;

    Vertical {
        Vertical {
            Rectangle {
                ListView {
                    for dialog[i] in GContent.dialogue.contents: ElevatedCard {
                        Horizontal {
                                // TODO: Use SearchBar for this
                                lang_view := ComboBox {
                                model: GContent.lang_list;
                                current-value: dialog.language;
                                enabled: {
                                    root.content_selecting == i
                                };
                                selected(current-value) => {
                                    GContent.dialogue.contents[i].language = current-value;
                                    submit_btn.visible = true;
                                }
                            }

                            content_view := TextEdit {
                                text: dialog.content;
                                enabled: {
                                    root.content_selecting == i
                                };
                                edited(value) => {
                                    GContent.dialogue.contents[i].content = value;
                                    submit_btn.visible = true;
                                }
                            }

                            IconButton {
                                icon: Icons.remove;
                                inline: true;
                                clicked => {
                                    GContent.delete_content(dialog.language);
                                }
                            }
                        }
                    }
                }
            }

            submit_btn := TextButton {
                text: "Submit";
                visible: false;
                clicked => {
                    GContent.update_content(GContent.dialogue);
                    self.visible = false;
                };
            }

            Horizontal {
                new_lang := ComboBox {
                    width: 20%;
                    model: GContent.lang_list;
                    current-index: 0;
                }

                new_content := TextEdit {
                    text: "new dialog";
                }

                TextButton {
                    text: "+";
                    clicked => {
                        GContent.update_content(GContent.dialogue);
                        GContent.add_lang_content(new_lang.current-value, new_content.text);
                        new_content.text = "";
                    };
                }
            }
        }

        HorizontalDivider { }

        Vertical {
            Rectangle {
                ListView {
                    // TODO: Add "Go to" the affected state
                    for affect[i] in GContent.dialogue.affects: Horizontal {
                        Text {
                            text: affect.class;
                        }

                        Text {
                            text: affect.state;
                        }

                        Button {
                            text: "🗑️";
                            clicked => {
                                GContent.delete_affect(affect.class);
                            }
                        }
                    }
                }
            }

            Horizontal {
                new_affect_class := ComboBox {
                    model: class_list;
                    current-index: 0;
                }
                // TODO: Filter state by class
                new_affect_state := ComboBox {
                    model: GContent.state_list;
                    current-index: 0;
                }

                Button {
                    text: "Add";
                    clicked => {
                        GContent.update_content(GContent.dialogue);
                        GContent.add_affect(new_affect_class.current-value, new_affect_state.current-value);
                    };
                }
            }
        }

        HorizontalDivider { }

        Vertical {
            Rectangle {
                ListView {
                    for event[i] in GContent.dialogue.events: Horizontal {
                        Text {
                            text: event;
                        }

                        Button {
                            text: "🗑️";
                            clicked => {
                                GContent.delete_event(i);
                            }
                        }
                    }
                }
            }

            Horizontal {
                new_event := ComboBox {
                    model: GContent.event_list;
                }

                Button {
                    text: "Add";
                    clicked => {
                        GContent.update_content(GContent.dialogue);
                        GContent.add_event(new_event.current-value);
                    };
                }
            }
        }
    }
}

export component ContentTab inherits TabReload {
    in-out property <bool> is_saved;
    property <int> selecting_class: -1;
    property <int> selecting_state: -1;
    property <int> selecting_dialog: -1;

    Horizontal {
        // TODO: Allow resizeable
        OutlinedCard {
            width: 15%;

            Vertical {
                SearchBox {
                    search(text) => {
                        GContent.search_class(text);
                        root.selecting_class = -1;
                        root.selecting_state = -1;
                        root.selecting_dialog = -1;
                    }
                }

                ListView {
                    for class_name[i] in GContent.classes: EditableTextBox {
                        value: class_name;
                        selected: {
                            root.selecting_class == i
                        };
                        // background: {
                        //     if (root.selecting_class == i) {
                        //         Palette.selection-background
                        //     } else {
                        //         Palette.background
                        //     }
                        // };
                        select => {
                            GContent.select-class(class_name);
                            root.selecting_class = i;
                            root.selecting_state = -1;
                            root.selecting_dialog = -1;
                        };
                        submit(new_name) => {
                            GContent.rename-class(class_name, new_name);
                            root.is_saved = false;
                        };
                        delete => {
                            GContent.remove-class(class_name);
                            root.is_saved = false;
                        };
                    }
                }

                Horizontal {
                    new_class := LineEdit {
                        placeholder-text: "New class";
                    }

                    ElevatedButton {
                        text: "Add";
                        clicked => {
                            GContent.add-class(new_class.text);
                            new_class.text = "";
                            root.is_saved = false;
                        };
                    }
                }
            }
        }

        OutlinedCard {
            width: 15%;

            Vertical {
                SearchBox {
                    search(text) => {
                        GContent.search_state(text);
                        root.selecting_state = -1;
                        root.selecting_dialog = -1;
                    }
                }

                ListView {
                    // TODO: Allow state to be reordered
                    for state_name[i] in GContent.states: EditableTextBox {
                        value: state_name;
                        selected: {
                            root.selecting_state == i
                        };
                        // background: {
                        //     if (root.selecting_state == i) {
                        //         Palette.selection-background
                        //     } else {
                        //         Palette.background
                        //     }
                        // };
                        select => {
                            GContent.select-state(state_name);
                            root.selecting_state = i;
                            root.selecting_dialog = -1;
                        };
                        submit(new_name) => {
                            GContent.rename-state(state_name, new_name);
                            root.is_saved = false;
                        };
                        delete => {
                            GContent.remove-state(state_name);
                            root.is_saved = false;
                        };
                    }
                }

                Rectangle {
                    visible: {
                        root.selecting_class >= 0
                    };
                    Horizontal {
                        new_state := LineEdit {
                            placeholder-text: "New state";
                        }

                        Button {
                            text: "Add";
                            clicked => {
                                GContent.add-state(new_state.text);
                                root.is_saved = false;
                                new_state.text = "";
                            }
                        }
                    }
                }
            }
        }

        OutlinedCard {
            width: 20%;

            Vertical {
                SearchBox {
                    search(text) => {
                        GContent.search_dialogue(text);
                        root.selecting_dialog = -1;
                    }
                }

                ListView {
                    for dialog[i] in GContent.dialogues: SelectableBox {
                        value: dialog;
                        selected: {
                            root.selecting_dialog == i
                        };

                        select => {
                            GContent.select-dialog(i);
                            root.selecting_dialog = i;
                        };
                        delete => {
                            GContent.remove-dialog(i);
                            root.is_saved = false;
                        };
                    }
                }

                ElevatedButton {
                    visible: {
                        root.selecting_state >= 0
                    };
                    text: "Add";
                    clicked => {
                        GContent.add-dialog();
                        root.is_saved = false;
                    }
                }
            }
        }

        OutlinedCard {
            DialogueBox {
                visible: {
                    root.selecting_dialog >= 0
                };
                class_list: GContent.classes;
            }
        }
    }
}
