import {
    ComboBox,
    LineEdit,
    Button,
    CheckBox,
    Palette,
    StandardButton,
    HorizontalBox,
} from "std-widgets.slint";
import { GContent } from "content_tab.slint";
import { GNameMap } from "namemap_tab.slint";

export global GFile {
    in-out property <int> file_format;
    in-out property <bool> enable_crypt;
    in-out property <string> encrypt_key;
    in-out property <string> file_path;
    in-out property <string> file_name;
    in-out property <bool> save_without_name;
    in-out property <bool> is_loading: false;

    // file_picker(load_true_save_false, force)
    callback file_picker(bool, bool);
    callback save(string, string, bool);
}

export component UnsaveLoadDialog inherits Dialog {
    callback request-close();

    title: "Dialogue Editor - Unsave Warning";

    Text {
        text: "Your work has not been saved yet! Continue without Save?";
    }

    StandardButton {
        kind: yes;
    }

    StandardButton {
        kind: cancel;
    }
}

export component FileSection inherits Rectangle {
    public function save() {
        if (GFile.file_path == "") {
            GFile.file_picker(false, false);
            GFile.is_loading = true;
        } else {
            GFile.save(GFile.file_path, GFile.encrypt_key, GFile.save_without_name);
            GFile.is_loading = true;
        }
    }

    public function save_as() {
        GFile.file_picker(false, false);
        GFile.is_loading = true;
    }

    public function open() {
        GFile.file_picker(true, false);
        GFile.is_loading = true;
    }

    HorizontalBox {
        alignment: start;

        Rectangle {
            Button {
                icon: @image-url("icons/btn_open.svg");
                clicked => {
                    open();
                }
            }

            Tooltip {
                text: @markdown("Open File");
            }
        }

        Rectangle {
            Button {
                icon: @image-url("icons/btn_save.svg");
                clicked => {
                    save();
                }
            }

            Tooltip {
                text: @markdown("Save File");
            }
        }

        Rectangle {
            Button {
                icon: @image-url("icons/btn_saveas.svg");
                clicked => {
                    save_as();
                }
            }

            Tooltip {
                text: @markdown("Save As");
            }
        }

        Rectangle {
            width: 1px;
            background: #2d2d2f;
        }

        Rectangle {
            Text {
                text: { if (GFile.file_name != "") { GFile.file_name } else { "Untitled" } };
                font-size: 14px;
                font-weight: 600;
            }

            Tooltip {
                Text {
                    text: GFile.file_path;
                }
            }
        }
    }
}
