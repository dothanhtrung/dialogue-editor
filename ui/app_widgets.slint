import {
    HorizontalBox,
    Button,
    VerticalBox,
    ComboBox,
    TextEdit,
    LineEdit,
    ListView,
    Palette,
} from "std-widgets.slint";

export struct ContentLang {
    language: string,
    content: string,
}

export struct Affect {
    class: string,
    state: string,
}

export struct UiDialogue {
    contents: [ContentLang],
    affects: [Affect],
}

// TODO: Event list
export component DialogueBox inherits Rectangle {
    in-out property <UiDialogue> dialogue;
    in property <[string]> lang_list;
    in property <[string]> class_list;
    in property <[string]> state_list;
    property <int> content_selecting;

    callback new_lang_content(string, string);
    callback new_affect(string, string);
    callback update_content();
    callback delete_content(string);
    callback delete_affect(string);

    VerticalBox {
        VerticalBox {
            height: 70%;

            Rectangle {
                background: Palette.control-background;

                ListView {
                    for dialog[i] in dialogue.contents: HorizontalBox {
                        height: 25%;
                        lang_view := ComboBox {
                            width: 20%;
                            model: lang_list;
                            current-value: dialog.language;
                            enabled: {
                                root.content_selecting == i
                            };
                            selected(current-value) => {
                                root.dialogue.contents[i].language = current-value;
                                submit_btn.visible = true;
                            }
                        }

                        content_view := TextEdit {
                            text: dialog.content;
                            enabled: {
                                root.content_selecting == i
                            };
                            edited(value) => {
                                root.dialogue.contents[i].content = value;
                                submit_btn.visible = true;
                            }
                        }

                        Button {
                            text: "🗑️";
                            clicked => {
                                delete_content(dialog.language);
                            }
                        }
                    }
                }
            }

            HorizontalBox {
                height: 20%;
                new_lang := ComboBox {
                    width: 20%;
                    model: lang_list;
                    current-index: 0;
                }

                new_content := TextEdit {
                    text: "new dialog";
                }

                Button {
                    text: "Add";
                    clicked => {
                        update_content();
                        new_lang_content(new_lang.current-value, new_content.text);
                        new_content.text = "";
                    };
                }
            }
        }

        VerticalBox {

            Rectangle {
                background: Palette.control-background;
                ListView {
                    // TODO: Add "Go to" the affected state
                    for affect[i] in dialogue.affects: HorizontalBox {
                        ComboBox {
                            model: class_list;
                            current-value: affect.class;
                            selected(current-value) => {
                                dialogue.affects[i].class = current-value;
                                submit_btn.visible = true;
                            }
                        }

                        ComboBox {
                            // TODO: Filter state by class
                            model: state_list;
                            current-value: affect.state;
                            selected(current-value) => {
                                dialogue.affects[i].state = current-value;
                                submit_btn.visible = true;
                            }
                        }

                        Button {
                            text: "🗑️";
                            clicked => {
                                delete_affect(affect.class);
                            }
                        }
                    }
                }
            }

            HorizontalBox {
                new_affect_class := ComboBox {
                    model: class_list;
                    current-index: 0;
                }

                new_affect_state := ComboBox {
                    model: state_list;
                    current-index: 0;
                }

                Button {
                    text: "Add";
                    clicked => {
                        update_content();
                        new_affect(new_affect_class.current-value, new_affect_state.current-value);
                    };
                }
            }
        }

        submit_btn := Button {
            text: "✅";
            visible: false;
            clicked => {
                root.update_content();
                self.visible = false;
            };
        }
    }
}

export component SelectableBox inherits Rectangle {
    in property <string> value;
    in property <bool> selected;

    callback delete_dialog();
    callback select();

    TouchArea {
        width: 100%;
        height: 100%;

        clicked => {
            select();
        }

        HorizontalBox {
            Text {
                text: {
                    if (value == "") {
                        return "New";
                    } else {
                        return value;
                    }
                };
            }

            del_btn := Button {
                text: "🗑️";
                visible: selected;
                clicked => {
                    delete_dialog();
                };
            }
        }
    }
}


export component EditableTextBox inherits Rectangle {
    in property <string> value;
    in-out property <bool> selected;

    callback submit(string);
    callback delete();
    callback select;

    touch_area := TouchArea {
        width: 100%;
        height: 100%;

        clicked => {
            select();
        }

        // TODO: Fix cropped view
        HorizontalBox {
            edit := LineEdit {
                text: value;
                enabled: selected;
                read-only: !selected;
                accepted(text) => {
                    submit(self.text);
                    selected = false;
                }
            }

            save_btn := Button {
                text: "✅";
                visible: selected; // TODO: If data is not submited, do not hide this button
                clicked => {
                    submit(edit.text);
                    selected = false;
                }
            }

            del_btn := Button {
                text: "🗑️";
                visible: selected;
                clicked => {
                    delete();
                    selected = false;
                }
            }
        }
    }
}
