import {
    Button,
    ComboBox,
    TextEdit,
    LineEdit,
    ListView,
    Palette,
    ScrollView,
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";


export component TagChip inherits Rectangle {
    background: #2a2a2b;
    border-radius: 12px;
    border-width: 1px;
    border-color: #2d2d2f;

    callback hover();
    callback clicked();
    callback btn_clicked();
}

export component AddButton inherits Rectangle {
    in property <string> text: "Add";

    callback clicked;

    background: #3878f5;
    border-radius: 4px;

    Button {
        width: 100%;
        height: 100%;

        clicked => { root.clicked(); }
    }

    Text {
        text: "Add";
        font-size: 13px;
        font-weight: 600;
    }
}

export component AddText inherits Rectangle {
    in property <string> placeholder;
    callback add(string);

    HorizontalBox {
        value := LineEdit {
            placeholder-text: placeholder;
            font-size: 13px;
            accepted(text) => { add(text); self.text = ""; }
        }

        AddButton {
            width: 48px;
            clicked => { add(value.text); value.text = ""; }
        }
    }
}

export component InlineButton inherits Rectangle {
    in property <image> image;
    in property <styled-text> tooltip;

    callback clicked();

    Button {
        clicked => { root.clicked(); }
    }

    Image {
        source: image;
    }

    Tooltip {
        text: tooltip;
    }
}

export component EditButton inherits InlineButton {
    image: @image-url("icons/btn_edit.svg");
    tooltip: @markdown("Submit");
}

export component DeleteButton inherits InlineButton {
    image: @image-url("icons/btn_delete.svg");
    tooltip: @markdown("Delete");
}

export component TabReload inherits Rectangle { }

export component SelectableBox inherits Rectangle {
    in property <string> value;
    in property <bool> selected;

    callback delete();
    callback select();

    TouchArea {
        width: 100%;
        height: 100%;

        clicked => {
            select();
        }

        HorizontalBox {
            Text {
                text: {
                    if (value == "") {
                        return "New";
                    } else {
                        return value;
                    }
                };
                font-size: 13px;
                font-weight: 400;
            }

            del_btn := DeleteButton {
                visible: selected;
                clicked => {
                    delete();
                };
            }
        }
    }
}


export component EditableTextBox inherits Rectangle {
    in property <string> value;
    in-out property <bool> selected;
    private property <bool> is_edited: false;

    callback submit(string);
    callback delete();
    callback select;

    touch_area := TouchArea {
        width: 100%;
        height: 100%;

        clicked => {
            select();
        }

        HorizontalBox {
            edit := LineEdit {
                text: value;
                enabled: selected;
                read-only: !selected;
                font-size: 13px;

                accepted(text) => {
                    submit(self.text);
                    is_edited = false;
                }

                edited(text) => {
                    is_edited = true;
                }
            }

            if (root.is_edited): EditButton {
                clicked => {
                    submit(edit.text);
                    is_edited = false;
                }
            }

            del_btn := DeleteButton {
                visible: selected;

                clicked => {
                    delete();
                    selected = false;
                }
            }
        }
    }
}

export component SearchBox inherits Rectangle {
    in property <string> placeholder: "Search...";

    callback search(string);

    background: #131314;

    LineEdit {
        placeholder-text: placeholder;
        font-size: 13px;
        width: 100%;

        edited(text) => { search(text); }
        accepted(text) => { search(text); }
    }
}

export component SelectionBox inherits Rectangle {
    in property <[string]> items: [];
    in property <string> placeholder-text;
    in property <length> dropdown-max-height: 480px;
    out property <string> text <=> focus-field.text;

    public function clear() {
        focus-field.text = "";
        popup.close();
    }

    callback filter(string);

    TouchArea {
        width: 100%;
        height: 100%;

        clicked => { popup.show(); root.filter(text); }

        focus-field := LineEdit {
            width: root.width;
            placeholder-text: root.placeholder-text;
            input-type: InputType.search;
            font-size: 13px;

            edited(text) => {
                root.filter(text);
                popup.show();
            }
        }
    }

    popup := PopupWindow {
        width: root.width;
        forward-focus: focus-field;
        close-policy: PopupClosePolicy.close-on-click-outside;
        x: 0;
        y: focus-field.height + 5px;

        VerticalBox {
            Rectangle {
                background: Palette.background;
                border-color: Palette.border;
                border-width: 1px;
                clip: false;
                max-height: root.dropdown-max-height;
                width: 100%;

                ListView {
                    for item in root.items: Rectangle {
                        background: item-touch.has-hover ?
                            Palette.accent-background : transparent;
                        border-radius: 2px;
                        height: 32px;

                        Rectangle {
                            width: 100%;
                            height: 100%;

                            Text {
                                text: item;
                                font-size: 13px;
                                font-weight: 400;
                                vertical-alignment: center;
                                x: 8px;
                                color: Palette.foreground;
                            }
                        }

                        item-touch := TouchArea {
                            width: 100%;
                            height: 100%;

                            clicked => {
                                focus-field.text = item;
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

export component ColumnTitle inherits Rectangle {
    in property <string> title;
    in property <string> count;

    HorizontalBox {
        alignment: space-between;
        Text {
            text: title;
            font-size: 13px;
            font-weight: 700;
        }

        Rectangle {
            border-radius: 4px;
            background: #2a2a2b;

            Text {
                text: count;
                font-weight: 600;
                font-size: 11px;
                color: #a3a3a8;
            }
        }
    }
}
