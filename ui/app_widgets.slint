import {
    HorizontalBox,
    Button,
    VerticalBox,
    ComboBox,
    TextEdit,
    LineEdit,
    ListView,
    Palette,
} from "std-widgets.slint";

export component TabReload inherits Rectangle {
    pure callback reload() -> color;
    background: reload();
}

export component SelectableBox inherits Rectangle {
    in property <string> value;
    in property <bool> selected;

    callback delete_dialog();
    callback select();

    TouchArea {
        width: 100%;
        height: 100%;

        clicked => {
            select();
        }

        HorizontalBox {
            Text {
                text: {
                    if (value == "") {
                        return "New";
                    } else {
                        return value;
                    }
                };
            }

            del_btn := Button {
                text: "🗑️";
                visible: selected;
                clicked => {
                    delete_dialog();
                };
            }
        }
    }
}


export component EditableTextBox inherits Rectangle {
    in property <string> value;
    in-out property <bool> selected;

    callback submit(string);
    callback delete();
    callback select;

    touch_area := TouchArea {
        width: 100%;
        height: 100%;

        clicked => {
            select();
        }

        // TODO: Fix cropped view
        HorizontalBox {
            edit := LineEdit {
                text: value;
                enabled: selected;
                read-only: !selected;
                accepted(text) => {
                    submit(self.text);
                    selected = false;
                }
            }

            save_btn := Button {
                text: "✅";
                visible: selected; // TODO: If data is not submited, do not hide this button
                clicked => {
                    submit(edit.text);
                    selected = false;
                }
            }

            del_btn := Button {
                text: "🗑️";
                visible: selected;
                clicked => {
                    delete();
                    selected = false;
                }
            }
        }
    }
}
