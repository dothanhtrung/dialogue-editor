import {
    Button,
    ComboBox,
    TextEdit,
    LineEdit,
    ListView,
    Palette,
} from "std-widgets.slint";
import {
    IconButton,
    Horizontal,
    Vertical,
    ElevatedCard,
} from "material-1.0/material.slint";
import { SearchBar } from "material-1.0/ui/components/search_bar.slint";
import { Icons } from "material-1.0/ui/icons/icons.slint";

export component TabReload inherits Rectangle {

}

export component SelectableBox inherits ElevatedCard {
    in property <string> value;
    in property <bool> selected;

    callback delete();
    callback select();

    TouchArea {
        width: 100%;
        height: 100%;

        clicked => {
            select();
        }

        Horizontal {
            Text {
                text: {
                    if (value == "") {
                        return "New";
                    } else {
                        return value;
                    }
                };
            }

            del_btn := IconButton {
                icon: Icons.remove;
                visible: selected;
                clicked => {
                    delete();
                };
            }
        }
    }
}


export component EditableTextBox inherits ElevatedCard {
    in property <string> value;
    in-out property <bool> selected;
    private property <bool> is_edited: false;

    callback submit(string);
    callback delete();
    callback select;

    touch_area := TouchArea {
        width: 100%;
        height: 100%;

        clicked => {
            select();
        }

        // TODO: Fix cropped view
        Horizontal {
            edit := LineEdit {
                text: value;
                enabled: selected;
                read-only: !selected;

                accepted(text) => {
                    submit(self.text);
                    is_edited = false;
                }

                edited(text) => {
                    is_edited = true;
                }
            }

            if (root.is_edited): IconButton {
                icon: Icons.check;
                tooltip: "Submit";
                inline: true;

                clicked => {
                    submit(edit.text);
                    is_edited = false;
                }
            }

            del_btn := IconButton {
                icon: Icons.remove;
                visible: selected;
                tooltip: "Remove";
                inline: true;

                clicked => {
                    delete();
                    selected = false;
                }
            }
        }
    }
}

export component SearchBox inherits ElevatedCard {
    callback search(string);
    LineEdit {
        width: 100%;
        height: 100%;
        placeholder-text: "Search...";
        edited(text) => { search(text); }
        accepted(text) => { search(text); }
    }
}
