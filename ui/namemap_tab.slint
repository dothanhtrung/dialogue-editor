import {
    LineEdit,
    Button,
    GridBox,
    ScrollView,
    Palette,
    ListView,
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";
import {
    TabReload,
    EditableTextBox,
    SearchBox,
    EditButton,
    DeleteButton,
    AddButton,
} from "app_widgets.slint";


export struct StringId {
    name: string,
    id: string, // Do not use int, since it is just i32 while we need id is u64
}

export global GNameMap {
    in-out property <[StringId]> classes;
    in-out property <[StringId]> states;
    in-out property <[StringId]> events;
    in-out property <[StringId]> sequences;

    callback refresh();

    callback delete_class(string);
    callback delete_state(string);
    callback delete_event(string);
    callback delete_sequence(string);
    callback update_class_id(string, string); // name, id
    callback update_state_id(string, string);
    callback update_event_id(string, string);
    callback update_sequence_id(string, string);
    callback new_class(string, string); // name ,id
    callback new_state(string, string); // name ,id
    callback new_event(string, string); // name ,id
    callback new_sequence(string, string); // name ,id
    callback search_class(string);
    callback search_state(string);
    callback search_event(string);
    callback search_sequence(string);
}

// TODO: Remove this tab. Intergrate ID into content and sequence tab.
// TODO: Allow rename
component NameMapItem inherits Rectangle {
    border-color: #292e3d;

    in property <StringId> value;
    property <bool> is_edited: false;

    callback update(string, string);
    callback delete(string);

    HorizontalBox {
        cross-axis-alignment: center;
        alignment: space-between;

        HorizontalBox {
            Path {
                width: 9.998px;
                height: 9.998px;
                commands: "M5.58602 0.999603C5.85123 0.99966 6.10557 1.10506 6.29308 1.29263L10.6454 5.64499C10.8713 5.87227 10.998 6.17966 10.998 6.50006C10.998 6.82047 10.8713 7.12786 10.6454 7.35513L7.35516 10.6454C7.12789 10.8712 6.8205 10.998 6.50009 10.998C6.17969 10.998 5.8723 10.8712 5.64502 10.6454L1.29266 6.29304C1.10509 6.10554 0.99969 5.8512 0.999634 5.58599V1.99969C0.999634 1.73445 1.105 1.48007 1.29255 1.29252C1.4801 1.10497 1.73448 0.999603 1.99972 0.999603H5.58602Z";
                stroke: #94a3b8;
                stroke-width: 2px;
            }

            Text {
                text: value.name;
                font-size: 14px;
                font-weight: 500;
            }
        }

        HorizontalBox {
            edit := LineEdit {
                text: value.id;
                input-type: number;
                font-size: 12px;

                edited(text) => {
                    is_edited = true;
                }
                accepted(text) => {
                    update(value.name, self.text);
                    is_edited = false;
                }
            }

            if (is_edited): EditButton {
                clicked => {
                    update(value.name, edit.text);
                    root.is_edited = false;
                }
            }

            DeleteButton {
                clicked => {
                    delete(value.name);
                }
            }
        }
    }
}

export component StringIdContainer inherits Rectangle {
    background: #1b1e28;
    border-radius: 8px;
    border-width: 1px;
    border-color: #292e3d;

    in property <[StringId]> values;
    in property <string> title;

    callback delete(string);
    callback update(string, string); // name, id
    callback new(string, string);
    callback search(string);

    VerticalLayout {
        Rectangle {
            background: #14161d;
            height: 48px;

            HorizontalBox {
                alignment: space-between;
                cross-axis-alignment: center;

                Text {
                    text: title + " NAME / ID";
                    font-size: 15px;
                    font-weight: 700;
                }

                Rectangle {
                    background: #1a2e44;
                    border-radius: 10px;
                    Text {
                        font-size: 11px;
                        font-weight: 700;
                        text: values.length + " items";
                    }
                }
            }
        }

        SearchBox {
            search(text) => {
                root.search(text);
            }
        }

        Rectangle {
            background: #1b1e28;

            ListView {
                for value[i] in values: NameMapItem {
                    value: value;

                    background: { if Math.mod(i, 2) == 0 { #14161d } else { #1b1e28; } };

                    update(name, id) => {
                        update(name,id);
                    }
                    delete(name) => {
                        delete(name);
                    }
                }
            }
        }

        Rectangle {
            background: #14161d;
            border-color: #292e3d;

            HorizontalBox {
                new_name := LineEdit {
                    placeholder-text: "Name";

                    accepted(text) => {
                        submit()
                    }
                }

                new_id := LineEdit {
                    placeholder-text: "ID";
                    input-type: number;
                    accepted(text) => {
                        submit()
                    }
                }

                AddButton {
                    width: 48px;
                    clicked => {
                        submit();
                    }
                }
            }
        }

        function submit() {
            new(new_name.text, new_id.text);
            new_name.text = "";
            new_id.text = "";
        }
    }
}


export component NameMapTab inherits TabReload {
    in-out property <bool> is_saved;

    HorizontalBox {
        StringIdContainer {
            title: "CLASS";
            values: GNameMap.classes;
            delete(name) => {
                GNameMap.delete_class(name);
                is_saved = false;
            }
            update(name, id) => {
                GNameMap.update_class_id(name, id);
                is_saved = false;
            }
            new(name, id) => {
                GNameMap.new_class(name, id);
                is_saved = false;
            }
            search(text) => {
                GNameMap.search_class(text);
            }
        }

        StringIdContainer {
            title: "STATE";
            values: GNameMap.states;
            delete(name) => {
                GNameMap.delete_state(name);
                is_saved = false;
            }
            update(name, id) => {
                GNameMap.update_state_id(name, id);
                is_saved = false;
            }
            new(name, id) => {
                GNameMap.new_state(name, id);
                is_saved = false;
            }
            search(text) => {
                GNameMap.search_state(text);
            }
        }

        StringIdContainer {
            title: "EVENT";
            values: GNameMap.events;
            delete(name) => {
                GNameMap.delete_event(name);
                is_saved = false;
            }
            update(name, id) => {
                GNameMap.update_event_id(name, id);
                is_saved = false;
            }
            new(name, id) => {
                GNameMap.new_event(name, id);
                is_saved = false;
            }
            search(text) => {
                GNameMap.search_event(text);
            }
        }

        StringIdContainer {
            title: "SEQUENCE";
            values: GNameMap.sequences;
            delete(name) => {
                GNameMap.delete_sequence(name);
                is_saved = false;
            }
            update(name, id) => {
                GNameMap.update_sequence_id(name, id);
                is_saved = false;
            }
            new(name, id) => {
                GNameMap.new_sequence(name, id);
                is_saved = false;
            }
            search(text) => {
                GNameMap.search_sequence(text);
            }
        }
    }
}
