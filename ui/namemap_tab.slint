import {
    LineEdit,
    Button,
    GridBox,
    ScrollView,
    Palette,
    ListView,
    VerticalBox,
    HorizontalBox,
} from "std-widgets.slint";
import {
    TabReload,
    EditableTextBox,
    SearchBox,
    EditButton,
    DeleteButton,
    AddButton,
} from "app_widgets.slint";


export struct StringId {
    name: string,
    id: string, // Do not use int, since it is just i32 while we need id is u64
}

export global GNameMap {
    in-out property <[StringId]> classes;
    in-out property <[StringId]> states;
    in-out property <[StringId]> events;
    in-out property <[StringId]> sequences;

    callback refresh();

    callback delete_class(string);
    callback delete_state(string);
    callback delete_event(string);
    callback delete_sequence(string);
    callback update_class_id(string, string); // name, id
    callback update_state_id(string, string);
    callback update_event_id(string, string);
    callback update_sequence_id(string, string);
    callback new_class(string, string); // name ,id
    callback new_state(string, string); // name ,id
    callback new_event(string, string); // name ,id
    callback new_sequence(string, string); // name ,id
    callback search_class(string);
    callback search_state(string);
    callback search_event(string);
    callback search_sequence(string);
}

// TODO: Remove this tab. Intergrate ID into content and sequence tab.
// TODO: Allow rename
component NameMapItem inherits Rectangle {
    border-color: #292e3d;

    in property <StringId> value;
    property <bool> is_edited: false;

    callback update(string, string);
    callback delete(string);

    HorizontalBox {
        cross-axis-alignment: center;
        alignment: space-between;

        HorizontalBox {
            Image {
                source: @image-url("icons/label_icon.svg");
            }

            Text {
                text: value.name;
                font-size: 14px;
                font-weight: 500;
            }
        }

        HorizontalBox {
            edit := LineEdit {
                text: value.id;
                input-type: number;
                font-size: 12px;

                edited(text) => {
                    is_edited = true;
                }
                accepted(text) => {
                    update(value.name, self.text);
                    is_edited = false;
                }
            }

            if (is_edited): EditButton {
                clicked => {
                    update(value.name, edit.text);
                    root.is_edited = false;
                }
            }

            DeleteButton {
                clicked => {
                    delete(value.name);
                }
            }
        }
    }
}

export component StringIdContainer inherits Rectangle {
    background: #1a1b1e;
    border-radius: 8px;
    border-width: 1px;
    border-color: #292e3d;

    in property <[StringId]> values;
    in property <string> title;

    callback delete(string);
    callback update(string, string); // name, id
    callback new(string, string);
    callback search(string);

    VerticalLayout {
        Rectangle {
            background: #14161d;
            height: 48px;

            HorizontalBox {
                alignment: space-between;
                cross-axis-alignment: center;

                Text {
                    text: title + " NAME / ID";
                    font-size: 15px;
                    font-weight: 700;
                }

                Rectangle {
                    background: #1a2e44;
                    border-radius: 10px;
                    Text {
                        font-size: 11px;
                        font-weight: 700;
                        text: values.length + " items";
                    }
                }
            }
        }

        SearchBox {
            search(text) => {
                root.search(text);
            }
        }

        Rectangle {
            ListView {
                for value[i] in values: NameMapItem {
                    value: value;

                    background: { if Math.mod(i, 2) == 0 { #14161d } else { #1b1e28; } };

                    update(name, id) => {
                        update(name,id);
                    }
                    delete(name) => {
                        delete(name);
                    }
                }
            }
        }

        Rectangle {
            HorizontalBox {
                new_name := LineEdit {
                    placeholder-text: "Name";

                    accepted(text) => {
                        submit()
                    }
                }

                new_id := LineEdit {
                    placeholder-text: "ID";
                    input-type: number;
                    accepted(text) => {
                        submit()
                    }
                }

                AddButton {
                    width: 48px;
                    clicked => {
                        submit();
                    }
                }
            }
        }

        function submit() {
            new(new_name.text, new_id.text);
            new_name.text = "";
            new_id.text = "";
        }
    }
}


export component NameMapTab inherits TabReload {
    in-out property <bool> is_saved;

    HorizontalBox {
        StringIdContainer {
            title: "CLASS";
            values: GNameMap.classes;
            delete(name) => {
                GNameMap.delete_class(name);
                is_saved = false;
            }
            update(name, id) => {
                GNameMap.update_class_id(name, id);
                is_saved = false;
            }
            new(name, id) => {
                GNameMap.new_class(name, id);
                is_saved = false;
            }
            search(text) => {
                GNameMap.search_class(text);
            }
        }

        StringIdContainer {
            title: "STATE";
            values: GNameMap.states;
            delete(name) => {
                GNameMap.delete_state(name);
                is_saved = false;
            }
            update(name, id) => {
                GNameMap.update_state_id(name, id);
                is_saved = false;
            }
            new(name, id) => {
                GNameMap.new_state(name, id);
                is_saved = false;
            }
            search(text) => {
                GNameMap.search_state(text);
            }
        }

        StringIdContainer {
            title: "EVENT";
            values: GNameMap.events;
            delete(name) => {
                GNameMap.delete_event(name);
                is_saved = false;
            }
            update(name, id) => {
                GNameMap.update_event_id(name, id);
                is_saved = false;
            }
            new(name, id) => {
                GNameMap.new_event(name, id);
                is_saved = false;
            }
            search(text) => {
                GNameMap.search_event(text);
            }
        }

        StringIdContainer {
            title: "SEQUENCE";
            values: GNameMap.sequences;
            delete(name) => {
                GNameMap.delete_sequence(name);
                is_saved = false;
            }
            update(name, id) => {
                GNameMap.update_sequence_id(name, id);
                is_saved = false;
            }
            new(name, id) => {
                GNameMap.new_sequence(name, id);
                is_saved = false;
            }
            search(text) => {
                GNameMap.search_sequence(text);
            }
        }
    }
}
