import {
    TabReload,
    EditableTextBox,
    SelectableBox,
    SearchBox,
    SelectionBox,
    AddText,
    AddButton,
    DeleteButton,
} from "app_widgets.slint";
import {
    Palette,
    LineEdit,
    ListView,
    Button,
    ComboBox,
    TextEdit,
    HorizontalBox,
    VerticalBox,
    ScrollView,
} from "std-widgets.slint";
import {
    HorizontalDivider,
    VerticalDivider,
} from "material-1.0/material.slint";
import { GConfig } from "common.slint";
import { GContent } from "content_tab.slint";

export struct UiSequenceItem {
    class: string,
    state: string,
    dialogue: string,
}

export struct SequenceInfo {
    name: string,
    id: string,
}

export global GSequence {
    in property <[string]> sequences;
    in property <[UiSequenceItem]> items;
    in property <SequenceInfo> info;
    in property <string> selected_sequence;

    callback add(string);
    callback select(string);
    callback delete(string);
    callback rename(string, string);
    callback search(string);

    callback delete_item(int);
    callback add_item(string, string, string);
}


export component SequenceTab inherits TabReload {
    in-out property <bool> is_saved;

    HorizontalBox {
        Rectangle {
            width: 340px;
            background: #1a1b1e;
            border-radius: 8px;
            border-width: 1px;
            border-color: #2e3035;

            VerticalBox {
                HorizontalBox {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalBox {
                        cross-axis-alignment: center;

                        Image {
                            source: @image-url("icons/sequence_icon.svg");
                            width: 10.5px;
                            height: 8.168px;
                        }

                        Text {
                            text: "SEQUENCE LIST";
                            font-size: 13px;
                            font-weight: 700;
                        }
                    }

                    Text {
                        text: GSequence.sequences.length + " total";
                        font-size: 11px;
                        font-weight: 600;
                        color: #9ca3af;
                    }
                }

                SearchBox {
                    search(text) => { GSequence.search(text); }
                }

                ListView {
                    for sequence in GSequence.sequences: Rectangle {
                        border-color: #2e3035;

                        EditableTextBox {
                            value: sequence;
                            selected: sequence == GSequence.selected_sequence;

                            submit(new_name) => { GSequence.rename(sequence, new_name); }
                            delete => { GSequence.delete(sequence); }
                            select => { GSequence.select(sequence); GSequence.selected_sequence = sequence; }
                        }
                    }
                }

                AddText {
                    placeholder: "New sequence";
                    add(text) => {
                        GSequence.add(text);
                        root.is_saved = false;
                    }
                }
            }
        }

        Rectangle {
            background: #1a1b1e;
            border-radius: 8px;
            border-width: 1px;
            border-color: #2e3035;

            VerticalBox {
                Rectangle {
                    border-color: #2e3035;
                    VerticalBox {
                        Text {
                            text: GSequence.info.name;
                            font-size: 17px;
                            font-weight: 700;
                        }

                        Text {
                            text: {
                                if GSequence.info.id != "" {
                                    "ID: " + GSequence.info.id
                                }
                                else {
                                    ""
                                }
                            };
                            font-size: 12px;
                            font-weight: 400;
                            color: #9ca3af;
                        }
                    }
                }

                Rectangle {
                    background: #222327;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #2e3035;

                    VerticalBox {
                        HorizontalBox {
                            cross-axis-alignment: center;

                            Path {
                                width: 7.001px;
                                height: 7.001px;
                                commands: "M1 4.5004H8.0008M4.5004 1V8.0008";
                                stroke: #38bdf8;
                                stroke-width: 2px;
                            }

                            Text {
                                text: "APPEND NEW SEQUENCE STEP";
                                font-size: 12px;
                                font-weight: 700;
                            }
                        }

                        HorizontalBox {
                            new_item_class := SelectionBox {
                                placeholder-text: "Class";
                                items: GContent.class_list;
                                filter(text) => {
                                    GContent.search_affect_class(text);
                                }
                            }

                            new_item_state := SelectionBox {
                                placeholder-text: "State";
                                items: GContent.state_list;
                                filter(text) => {
                                    GContent.search_affect_state(new_item_class.text, text);
                                }
                            }

                            new_item_dialogue := LineEdit {
                                placeholder-text: "Dialogue Index";
                                input-type: InputType.number;
                                font-size: 13px;
                            }

                            AddButton {
                                width: 48px;
                                clicked => {
                                    GSequence.add_item(new_item_class.text, new_item_state.text, new_item_dialogue.text);
                                    root.is_saved = false;
                                }
                            }
                        }
                    }
                }

                VerticalBox {
                    Text {
                        text: "Ordered Steps (" + GSequence.items.length + ")";
                        color: #a3a3a8;
                        font-size: 12px;
                        font-weight: 600;
                    }

                    ListView {
                        for item[id] in GSequence.items: Rectangle {
                            background: #222327;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #2e3035;

                            HorizontalBox {
                                cross-axis-alignment: center;
                                alignment: space-between;

                                HorizontalBox {
                                    Rectangle {
                                        background: #121315;
                                        border-radius: 4px;
                                        Text {
                                            text: "#" + (id + 1);
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #38bdf8;
                                        }
                                    }

                                    HorizontalBox {
                                        Rectangle {
                                            background: #1e293b;
                                            border-radius: 4px;
                                            Text {
                                                text: item.class;
                                                font-size: 13px;
                                                font-weight: 600;
                                                color: #93c5fd;
                                            }
                                        }

                                        Text {
                                            text: "/";
                                            color: #6b7280;
                                            font-size: 13px;
                                            font-weight: 400;
                                        }

                                        Rectangle {
                                            background: #27251f;
                                            border-radius: 4px;
                                            Text {
                                                text: item.state;
                                                color: #fde047;
                                                font-size: 13px;
                                                font-weight: 600;
                                            }
                                        }

                                        Text {
                                            text: "/";
                                            color: #6b7280;
                                            font-size: 13px;
                                            font-weight: 400;
                                        }

                                        Text {
                                            text: "Dialogue ID:";
                                            font-size: 13px;
                                            color: #6b7280;
                                            font-weight: 400;
                                        }

                                        Text {
                                            text: item.dialogue;
                                            color: #f3f4f6;
                                            font-size: 13px;
                                            font-weight: 700;
                                        }
                                    }
                                }

                                DeleteButton {
                                    clicked => {
                                        GSequence.delete_item(id);
                                        root.is_saved = false;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
