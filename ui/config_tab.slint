
import { TabReload } from "app_widgets.slint";
import {
    Palette,
    Button,
    LineEdit,
    ListView,
    CheckBox,
} from "std-widgets.slint";
import {
    Horizontal,
    Vertical,
    ElevatedButton,
    InputChip,
    OutlinedCard,
    Grid,
} from "material-1.0/material.slint";
import { GFile } from "file_section.slint";
import { Icons } from "material-1.0/ui/icons/icons.slint";

export global GConfig {
    in-out property <[string]> lang_list;
    in-out property <[string]> all_langs;

    callback delete_lang(string);
    callback add_lang(string);
}

export component Tag inherits Rectangle {
    in property <string> value;
    callback delete();

    Horizontal {
        Text {
            text <=> value;
        }

        Button {
            text: "x";
            clicked => {
                delete();
            }
        }
    }
}

export component ConfigTab inherits TabReload {
    Vertical {
        OutlinedCard {
            CheckBox {
                text: "Save dialogue without name map";
                checked <=> GFile.save_without_name;
            }
        }

        if (GFile.enable_crypt):
        OutlinedCard {
            LineEdit {
                text <=> GFile.encrypt_key;
                placeholder-text: "Encryption key";
            }
        }

        OutlinedCard {
            Vertical {
                Text {
                    text: "Supported languages";
                }

                Horizontal {
                    for lang[i] in GConfig.lang_list: InputChip {
                        text: lang;
                        trailing_icon: Icons.close;
                        trailing_icon_clicked => {
                            GConfig.delete_lang(lang);
                        }
                    }
                }

                new_lang := LineEdit {
                    placeholder-text: "Language code in ISO-639-3";
                }

                ElevatedButton {
                    text: "Add";
                    clicked => {
                        GConfig.add_lang(new_lang.text);
                        self.text = "";
                    }
                }
            }
        }
    }
}
